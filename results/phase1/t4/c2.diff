+    src = TensorView(W_qkv).reshape_dim(dim=0, shape=(N_PRGS, H0, H1_SHARD)).select(dim=0, index=prg_id)
+    nisa.dma_copy(dst=w_sb, src=src.get_view(), dge_mode=nisa.dge_mode.hwdge)
+    return w_sb
+
